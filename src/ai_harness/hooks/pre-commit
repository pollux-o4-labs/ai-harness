#!/usr/bin/env bash
# 목적: 커밋 전 문서 게이트 3종 — 설치된 ai-harness CLI로 실행한다.
#   (1) ai-harness check-doc --staged — 스테이징된 .md가 문서 폼
#       (docs_format/<유형>.md) 줄 예산을 지키는지.
#   (2) ai-harness gen-readmes --check — 자동생성 인덱스(BLUF-INDEX)가 원본과
#       어긋나지 않는지(수기 편집·미갱신 0). 어긋나면 커밋을 막는다.
#   (3) ai-harness gen-pr-template --check — org PR 템플릿이 REQUIRED_CHECKS 등
#       정본 생성물과 어긋나지 않는지. **단, 이 저장소가 그 템플릿 파일을 아예
#       안 쓰면(파일 없음) 검사 자체를 건너뛴다** — 강제하면 PR 템플릿 기능을
#       안 쓰는 소비 저장소의 모든 커밋이 막힌다. 아래 (3) 블록 참조.
#   셋 중 하나라도 비영 종료면 커밋을 막는다(git pre-commit 규약 — 0=통과).
#
# fail-open: ai-harness 가 PATH에 없으면(미설치) 게이트를 건너뛴다 — CLI 하나가
#   없다고 저장소의 모든 커밋이 막히면 게이트가 자기 자신을 잠근다.
#
# 설치: ai-harness 는 `uv tool install`(또는 pip)로 머신에 한 번 설치한다. 이
#   훅 파일은 hooks/에 버전관리되고, `ai-harness install-hooks` 가 .git/hooks/로
#   복사·chmod +x 한다(.git/hooks는 버전관리 안 됨).
set -euo pipefail

if ! command -v ai-harness >/dev/null 2>&1; then
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

ai-harness check-doc --staged

# 종료코드로 경우를 가른다. 1(인덱스 어긋남)에만 여기서 처방을 덧붙이고, 나머지
# 비영 코드(손글씨·마커 중복·쓰기 실패)는 gen-readmes가 이미 처방까지 출력하므로
# 그대로 통과시킨다 — 같은 규범을 두 곳에 두면 갈라진다.
ai-harness gen-readmes --check || rc=$?
if [ "${rc:-0}" -eq 1 ]; then
    cat >&2 <<'MSG'

[pre-commit] 위 README의 자동생성 인덱스가 원본과 어긋난다.
  → ai-harness gen-readmes 를 돌리고 바뀐 README도 같이 커밋하라.

MSG
    exit 1
elif [ "${rc:-0}" -ne 0 ]; then
    exit "$rc"
fi

# (3) PR 템플릿 드리프트 — 그 템플릿 파일이 이미 있는 저장소에서만 검사한다.
#     `gen-pr-template --check`는 파일이 없어도 "생성하라"며 비영 종료하는데,
#     그건 사람이 도입 여부를 확인하려고 명시적으로 돌리는 용도지 이 훅처럼
#     모든 커밋에 강제로 거는 용도가 아니다 — 파일 유무로 먼저 갈라 대상 저장소가
#     이 기능을 안 쓰기로 한 선택(파일 미생성)을 존중한다.
#     경로는 GitHub이 정한 자리라 여기 그대로 쓴다. 이 값을 CLI에 물어보는
#     길도 있었지만, 그러면 훅이 "새 CLI에만 있는 물음"에 기대게 되고 설치본이
#     낡은 순간 훅이 죽는다(실측: 그 방식으로 만들었다가 exit 2로 죽었다).
#     대신 이 리터럴이 생성기 상수와 같은지는 테스트가 잡는다(빌드타임 고정).
#     통과/실패 메시지는 gen_pr_template.py가 이미 stderr에 내므로(없음 안내·
#     unified diff) 여기서 더 말하지 않는다(위 (2)처럼 같은 규범을 두 곳에 안 둔다).
#
#     **설치본이 낡아 이 서브커맨드를 모르면 조용히 넘기지 않고 그대로 죽는다.**
#     맨 위 "CLI가 아예 없으면 건너뛴다"와는 다르다 — 없는 것은 이 도구를 안
#     쓰기로 한 저장소지만, 낡은 것은 쓰기로 해놓고 갱신을 안 한 상태다.
#     그 상태를 조용히 넘기면 "검사가 도는 줄 알았는데 안 돌던" 바로 그 사고가
#     된다(조용한 통과와 조용한 부재는 겉모습이 같다). 막되, 무엇을 하면 되는지
#     한 줄을 덧붙인다 — 알 수 없는 명령 메시지만으로는 "재설치하라"까지 안 온다.
#     드리프트(1)는 gen-pr-template가 이미 처방을 내므로 여기서 또 말하지 않는다.
if [ -f "$repo_root/.github/PULL_REQUEST_TEMPLATE.md" ]; then
    tpl_rc=0
    ai-harness gen-pr-template --check || tpl_rc=$?
    if [ "$tpl_rc" -ne 0 ]; then
        if [ "$tpl_rc" -ne 1 ]; then
            cat >&2 <<'MSG'

[pre-commit] PR 서식 검사를 못 돌렸다 — 설치된 ai-harness가 낡았을 수 있다.
  → uv tool install --force git+https://github.com/pollux-o4-labs/ai-harness.git

MSG
        fi
        exit "$tpl_rc"
    fi
fi
